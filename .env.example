# ── Paystack credentials (server-side only) ──────────────────────
# Dashboard → Settings → API Keys & Webhooks
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Money routing ───────────────────────────────────────────────
# Every payment is initialised with this subaccount code.
SUBACCOUNT_CODE=ACCT_4i2l4tyiv5p48cu
# account | subaccount — who absorbs Paystack's transaction fee
BEARER=account
# Flat Naira amount retained by the MAIN account per payment (0 = none)
TRANSACTION_CHARGE_NGN=0

# ── Amounts ─────────────────────────────────────────────────────
USD_TO_NGN_RATE=1600
MIN_AMOUNT_NGN=100
MAX_AMOUNT_NGN=5000000

# ── Site ────────────────────────────────────────────────────────
PORT=3000
SITE_URL=http://localhost:3000

# ── Behaviour ───────────────────────────────────────────────────
VERIFY_ATTEMPTS=6
REQUEST_TIMEOUT_MS=15000
INIT_RATE_LIMIT=15
VERIFY_RATE_LIMIT=60
